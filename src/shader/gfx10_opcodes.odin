opcode_name :: proc(enc: Encoding, op: u16) -> (string, bool) {
	tbl: []Opcode_Entry
	switch enc {
	case .Sop2:    tbl = OP_SOP2[:]
	case .Sopk:    tbl = OP_SOPK[:]
	case .Sop1:    tbl = OP_SOP1[:]
	case .Sopc:    tbl = OP_SOPC[:]
	case .Sopp:    tbl = OP_SOPP[:]
	case .Smem:    tbl = OP_SMEM[:]
	case .Vop2:    tbl = OP_VOP2[:]
	case .Vop1:    tbl = OP_VOP1[:]
	case .Vopc:    tbl = OP_VOPC[:]
	case .Vop3:    tbl = OP_VOP3[:]
	case .Vop3p:   tbl = OP_VOP3P[:]
	case .Vintrp:  tbl = OP_VINTRP[:]
	case .Ds:      tbl = OP_DS[:]
	case .Mubuf:   tbl = OP_MUBUF[:]
	case .Mtbuf:   tbl = OP_MTBUF[:]
	case .Mimg:    tbl = OP_MIMG[:]
	case .Exp:     return "exp", op == 0
	case .Flat:    tbl = OP_FLAT[:]
	case .Global:  tbl = OP_GLOBAL[:]
	case .Scratch: tbl = OP_SCRATCH[:]
	}
	lo := 0
	hi := len(tbl)
	for lo < hi {
		mid := lo + (hi - lo) / 2
		v := tbl[mid].op
		if v == op {
			return tbl[mid].name, true
		}
		if v < op {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	return "", false
}
