# ---------------------------------------------------------------------------
# RULE #1: nothing from any proprietary title source is ever committed.
# Everything is built from files the user supplies at runtime.
# Run `.\build.ps1 policy` to verify the repository before committing.
# See docs/asset-policy.md.
# ---------------------------------------------------------------------------

# Build output
/build/
/.cache/

# Local configuration (contains paths to YOUR files)
/vasperty.toml
/victory.toml

# Places people tend to drop data into. Keep data outside the repo instead.
/game/
/games/
/assets/
/data/
/dump/
/dumps/
/extracted/
/cache/
/out/

# Executables, libraries, symbols
*.exe
*.dll
*.pdb
*.lib
*.sys
*.obj
*.exp
*.ilk

# Console packages and containers
*.xvd
*.xvc
*.msixvc
*.xsp
*.cab
*.msi

# Typical game data (non-exhaustive on purpose; the policy check is an allowlist)
*.bin
# The one exception (docs/asset-policy.md): the BCPack format's constant tables.
!/src/formats/bcpack-tables.bin
*.dat
*.pak
*.rpf
*.ttpf
*.dds
*.ktx
*.ktx2
*.dxbc
*.dxil
*.cso
*.spv
*.wav
*.xma
*.ogg
*.opus
*.mp3
*.mp4
*.bik
*.bk2
*.awc
*.zip
*.7z
*.rar

# Editor / OS noise
.vs/
.idea/
*.swp
Thumbs.db
.DS_Store

# Debug logs & local dumps
*.log
*.bmp
*.raw
*.tmp
